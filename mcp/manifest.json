{
  "manifest_version": "0.3",
  "name": "caderno-mcp",
  "display_name": "Caderno+ · Canvas PUCPR",
  "version": "0.1.0",
  "description": "O seu Canvas da PUCPR para o Claude: quanto falta, prazos, notas, avisos e módulos. Só leitura. Não oficial.",
  "author": { "name": "Enzo Bossmann" },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "server.js",
    "mcp_config": { "command": "node", "args": ["${__dirname}/server.js"], "env": { "CADERNO_MCPB_TOKEN": "${user_config.canvas_token}" } }
  },
  "user_config": {
    "canvas_token": { "type": "string", "title": "Token do Canvas", "description": "Canvas → Conta → Configurações → Novo token de acesso (expira no fim do semestre).", "sensitive": true, "required": true }
  },
  "tools": [
    { "name": "quanto_falta", "description": "Quanto falta em cada matéria" },
    { "name": "upcoming", "description": "Entregas e provas que vêm" },
    { "name": "grades", "description": "Notas do Canvas" },
    { "name": "courses", "description": "Matérias do semestre" },
    { "name": "announcements", "description": "Avisos recentes" },
    { "name": "modules", "description": "Módulos de uma matéria" }
  ]
}
