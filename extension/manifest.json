{
  "manifest_version": 3,
  "name": "Quanto falta · PUCPR",
  "version": "0.3.0",
  "description": "Lê as suas notas no Canvas da PUCPR e mostra quanto falta para passar em cada matéria.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quanto falta",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://falta-quanto.vercel.app/"
}
