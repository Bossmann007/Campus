{
  "manifest_version": 3,
  "name": "Campus+ · PUCPR",
  "version": "1.0.3",
  "description": "O Canvas da PUCPR melhorado: semana com entregas e provas, avisos juntos, lembretes, tema escuro, quanto falta em cada matéria e download dos arquivos.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Campus+",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://pucpr.instructure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pucpr.instructure.com/*"
      ],
      "js": [
        "prefs.js",
        "theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pucpr.instructure.com/*"
      ],
      "js": [
        "collect.js",
        "core.js",
        "files.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://falta-quanto.vercel.app/",
  "web_accessible_resources": [
    {
      "resources": [
        "app.html"
      ],
      "matches": [
        "https://pucpr.instructure.com/*"
      ]
    }
  ]
}
