{
  "manifest_version": 3,
  "name": "Quanto falta · PUCPR",
  "version": "0.1.0",
  "description": "Lê as suas notas no Canvas da PUCPR e mostra quanto falta para passar em cada matéria.",
  "action": { "default_popup": "popup.html", "default_title": "Quanto falta" },
  "permissions": ["activeTab", "scripting"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
