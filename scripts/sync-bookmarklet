#!/bin/sh
# Bundle the extension's page scripts into the bookmarklet on index.html (between the /*CP-BM*/ markers): prefs, collect, core,
# files and content.js run inside one function with an in-memory stand-in for the chrome APIs (no reminders, downloads or theme).
set -eu
cd "$(dirname "$0")/.."
python3 - <<'PY'
import json, re
read = lambda f: open("extension/" + f, encoding="utf-8").read()
shim = """if (location.hostname !== "pucpr.instructure.com") { alert("Abra o Canvas da PUCPR (pucpr.instructure.com) e clique de novo neste favorito."); return; }
if (!/^\\/(dashboard)?$|^\\/courses\\/\\d+(\\/(modules|files|assignments|grades|announcements))?\\/?$/.test(location.pathname)) { alert("Campus+: abra o painel do Canvas ou a página de uma matéria e clique de novo."); return; }
const mem = {}, chrome = { runtime: { getManifest: () => ({ version: "bookmarklet" }), sendMessage: () => Promise.resolve() },
  storage: { local: { get: async k => ({ [k]: k === "prefs" ? { files: false, remind: false } : mem[k] }), set: async o => { Object.assign(mem, o); }, remove: async k => { delete mem[k]; } } } };
"""
src = "(function () {\n" + shim + "\n".join(read(f) for f in ("prefs.js", "collect.js", "core.js", "files.js", "content.js")) + "\n})();"
page = open("index.html", encoding="utf-8").read()
lit = json.dumps(src, ensure_ascii=False).replace("</", "<\\/")
page, n = re.subn(r"/\*CP-BM\*/[\s\S]*?/\*CP-BM\*/", lambda m: "/*CP-BM*/" + lit + "/*CP-BM*/", page)
assert n == 1
open("index.html", "w", encoding="utf-8").write(page)
print("bookmarklet: %d chars" % len(src))
PY
