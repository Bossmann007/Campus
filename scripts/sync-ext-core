#!/bin/sh
# Embed the rule packs, then copy app.html's <script id="core"> into extension/core.js (the in-Canvas panels compute with it).
# The calculator itself lives in Canvas now (no extension page); app.html stays the site's calculator.
set -eu
cd "$(dirname "$0")/.."
node scripts/sync-rules   # rules/<term>/*.json -> the /*RULES*/ block of app.html's core (and the turma lists)
python3 - <<'PY'
import re
src = open("app.html", encoding="utf-8").read()
head = "// Generated from app.html by scripts/sync-ext-core; do not edit by hand.\n"
blocks = {}
for name in ("core",):
    m = re.search(r'<script id="%s">([\s\S]*?)</script>' % name, src)
    blocks[name] = m
open("extension/core.js", "w", encoding="utf-8").write(head.replace("app.html", 'app.html <script id="core">') + blocks["core"].group(1).strip("\n") + "\n")
PY
echo "extension/core.js updated"
